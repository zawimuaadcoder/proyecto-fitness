# --- Supabase (obligatorias) ---------------------------------------------
# URL del proyecto (Supabase → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clave SECRETA (service role / "secret key"). Solo se usa en el servidor:
# nunca lleva el prefijo NEXT_PUBLIC_. La integración Vercel↔Supabase ya la
# crea como SUPABASE_SERVICE_ROLE_KEY; cualquiera de los dos nombres sirve.
SUPABASE_SECRET_KEY=

# --- Opcionales ------------------------------------------------------------
# Secreto para firmar las cookies de sesión (32+ caracteres).
# OBLIGATORIO en producción. En desarrollo, si falta, se deriva de la clave
# secreta de Supabase.
SESSION_SECRET=
# Hash de la contraseña de grupo (npm run hash-password -- "contraseña").
# Si falta, la app pide definirla en el primer acceso y la guarda (hasheada)
# en la tabla app_config.
APP_PASSWORD_HASH=
# Permite crear perfiles demo en producción ("true" para activarlo).
ENABLE_DEMO=
# Código que se exige al definir la contraseña de grupo en el primer acceso
# (evita que un desconocido se adelante en un despliegue recién creado).
SETUP_TOKEN=
